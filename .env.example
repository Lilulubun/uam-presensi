# Public client (VITE_* exposed to browser bundle)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<eyJ_anon_key>

# Debug toggles — leave false in production
VITE_GPS_DEBUG=false
VITE_DEMO_MODE=false

# Seed script only — NOT exposed to client, NOT prefixed with VITE_
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<eyJ_service_role_key>
SEED_PENGAJAR_PASSWORD=<password>
SEED_PENGURUS_PASSWORD=<password>
