# Public client (VITE_* are exposed to the browser bundle — publishable key is the renamed anon key)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_or_eyJ_anon_jwt>

# Debug toggles — leave false in production
VITE_GPS_DEBUG=false
VITE_DEMO_MODE=false

# Seed script only — NOT exposed to client, NOT prefixed with VITE_
SUPABASE_SECRET_KEY=<sb_secret_or_eyJ_service_role_jwt>
PWD_PENGAJAR=<password>
PWD_PENGURUS=<password>
